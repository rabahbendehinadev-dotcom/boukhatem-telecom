# ─────────────────────────────────────────────────────────────────────────────
# Required environment variables — copy to .env and fill in real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080

# ── Database (PostgreSQL external to the container) ──────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/boukhatem_telecom

# ── Authentication secrets (generate with: openssl rand -hex 64) ─────────────
SESSION_SECRET=change-me-use-openssl-rand-hex-64
JWT_SECRET=change-me-use-openssl-rand-hex-64

# ── Admin bootstrap (creates super admin on first start) ─────────────────────
ADMIN_EMAIL=admin@yourstore.dz
ADMIN_PASSWORD=ChangeThisSecurePassword!

# ── Google Cloud Storage (for product/banner image uploads) ──────────────────
# Option A: inline the JSON key as a single-line string (recommended for Dokploy)
GCP_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Option B: path to mounted service-account key file
# GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-key.json

DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-gcs-bucket-name
PRIVATE_OBJECT_DIR=uploads/private
PUBLIC_OBJECT_SEARCH_PATHS=uploads/public
